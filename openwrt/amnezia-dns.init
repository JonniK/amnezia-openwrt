#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # USE_PROCD/START/STOP are consumed by /etc/rc.common framework
USE_PROCD=1
START=97
STOP=10

start_service() {
  [ "$(uci -q get amnezia.config.dot_enabled)" = 1 ] || return 0
  /usr/bin/amnezia-dns-ctl apply || true   # tolerant of no-tunnel-yet; chain degrades
  procd_open_instance
  procd_set_param command /usr/bin/amnezia-dns-ctl watchdog
  procd_set_param respawn
  procd_close_instance
}

stop_service() {
  # H1: set sentinel so cmd_disable does NOT call "$AMNEZIA_DNS_INIT" stop again
  # (which would re-enter stop_service → infinite recursion + fork storm).
  # AMNEZIA_DNS_TEARDOWN=1: service lifecycle stop (init stop/restart/reboot) —
  # must NOT flip the persistent dot_enabled toggle; only a user-facing
  # 'amnezia-dns-ctl disable' (no env) should do that.
  AMNEZIA_DNS_STOPPING=1 AMNEZIA_DNS_TEARDOWN=1 /usr/bin/amnezia-dns-ctl disable >/dev/null 2>&1 || true
}
