#!/bin/sh
# AmneziaWG multi-tunnel failover monitor daemon.
# POSIX sh / BusyBox ash only — no bashisms.
# shellcheck source=lib/amnezia-common.sh
# shellcheck source=lib/amnezia-routing.sh
AMNEZIA_LIB=${AMNEZIA_LIB:-/usr/lib/amnezia}
if [ -f "$AMNEZIA_LIB/amnezia-common.sh" ]; then
  . "$AMNEZIA_LIB/amnezia-common.sh"
else
  . "$(dirname "$0")/lib/amnezia-common.sh"
fi
if [ -f "$AMNEZIA_LIB/amnezia-routing.sh" ]; then
  . "$AMNEZIA_LIB/amnezia-routing.sh"
else
  . "$(dirname "$0")/lib/amnezia-routing.sh"
fi

PROBE_TBL_BASE=110
HS_STALE=150
ST_DIR=${ST_DIR:-/tmp/amnezia-fo}
DEBOUNCE_N=3

mkdir -p "$ST_DIR" 2>/dev/null

# ── health ──────────────────────────────────────────────────────────────────

handshake_fresh() {  # $1 iface
  _hs=$(awg show "$1" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
  [ -n "$_hs" ] || return 1
  _now=$(date +%s 2>/dev/null || echo 0)
  [ $(( _now - _hs )) -lt "$HS_STALE" ]
}

# Called once at startup per tunnel. Sets up a persistent probe route + per-tunnel rule.
# Each tunnel gets its own routing table (PROBE_TBL_BASE + awgN index) and its ip rule
# is keyed by the tunnel's source address, so tunnels sharing the same track_ip each
# get an independent, correctly-bound probe path regardless of shared target.
# Idempotency is tracked via a per-iface state file (not per-target) so two tunnels
# with the same track_ip do not overwrite each other's rule marker.
probe_setup() {  # $1 iface $2 target_ip $3 probe_tbl
  _tbl=$3
  ip route replace "$2" dev "$1" table "$_tbl" 2>/dev/null
  _pf="$ST_DIR/probe_rule_$1"
  if [ ! -f "$_pf" ]; then
    # Use the tunnel's own source address as the ip rule selector so that pings
    # bound to this iface (which use this source addr) look up the per-tunnel table,
    # not a shared "to <target>" rule that only the first tunnel would win.
    _src=$(ip -4 addr show dev "$1" 2>/dev/null \
      | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
    if [ -n "$_src" ]; then
      ip rule add from "$_src" lookup "$_tbl" 2>/dev/null && touch "$_pf"
    else
      # Interface not yet up (no address assigned). No rule is installed; the
      # handshake-freshness check remains the primary health signal until the
      # tunnel comes up and probe_setup is re-called on the next daemon start.
      touch "$_pf"
    fi
  fi
}

probe_cleanup() {  # $1 iface $2 target_ip $3 probe_tbl
  _tbl=$3
  _src=$(ip -4 addr show dev "$1" 2>/dev/null \
    | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
  [ -n "$_src" ] && ip rule del from "$_src" lookup "$_tbl" 2>/dev/null
  ip route del "$2" table "$_tbl" 2>/dev/null
  rm -f "$ST_DIR/probe_rule_$1"
}

ping_via() {  # $1 iface $2 target; returns 0 when reachable.
  ping -I "$1" -c1 -W2 "$2" >/dev/null 2>&1
}

# Healthy if handshake fresh (returns immediately, no ping) OR ping succeeds.
tunnel_healthy() {  # $1 iface $2 track_ip
  handshake_fresh "$1" && return 0
  ping_via "$1" "$2"
}

# ── debounce / transition handlers ──────────────────────────────────────────

state_reset() { echo "up 0" > "$ST_DIR/$1"; }
state_get()   { awk '{print $1}' "$ST_DIR/$1" 2>/dev/null || echo up; }

# $1 iface, $2 ok(1)/fail(0). Returns 0 if state CHANGED.
debounce() {
  _s=$(awk '{print $1}' "$ST_DIR/$1" 2>/dev/null || echo up)
  _c=$(awk '{print $2}' "$ST_DIR/$1" 2>/dev/null || echo 0)
  if [ "$2" = 1 ]; then _want=up; else _want=down; fi
  if [ "$_s" = "$_want" ]; then echo "$_s 0" > "$ST_DIR/$1"; return 1; fi
  _c=$((_c+1))
  if [ "$_c" -ge "$DEBOUNCE_N" ]; then echo "$_want 0" > "$ST_DIR/$1"; return 0; fi
  echo "$_s $_c" > "$ST_DIR/$1"; return 1
}

# Called on debounce down→up transition. Clears the exit-IP probe cache so the
# first post-recovery poll re-probes the tunnel's current public egress address.
_on_tunnel_up() {  # $1 iface
  amz_log "tunnel $1 came up"
  rm -f "$ST_DIR/exitip.${1}.ts" "$ST_DIR/exitip.${1}.ip"
}

# ── exit-IP probe ────────────────────────────────────────────────────────────

# Refresh one tunnel's public egress IP, bound to its device, cached with TTL.
# Safe to call from a detached subshell; never invoked synchronously in poll body.
# $1 = awgN ; echoes ip or "" (keeps last-known on curl failure)
_probe_exit_ip() {
  _ifn=$1
  _cf="$ST_DIR/exitip.${_ifn}.ip"
  _tf="$ST_DIR/exitip.${_ifn}.ts"
  _now=$(date +%s)
  _ts=$(cat "$_tf" 2>/dev/null || echo 0)
  if [ -f "$_cf" ] && [ $((_now - _ts)) -lt "${AMNEZIA_EXITIP_TTL:-300}" ]; then
    cat "$_cf"
    return
  fi
  _ip=""
  for _u in ${AMNEZIA_IPECHO_URLS:-https://api.ipify.org}; do
    _ip=$(curl --interface "if!${_ifn}" -fsSL --connect-timeout 5 --max-time 8 "$_u" 2>/dev/null \
          | tr -d ' \t\r\n' | grep -Eo '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || true)
    [ -n "$_ip" ] && break
  done
  if [ -n "$_ip" ]; then
    printf '%s' "$_ip" > "$_cf"
    printf '%s' "$_now" > "$_tf"
    echo "$_ip"
  else
    # Return stale cached value on failure (stale-ok: prefer last-known over nothing)
    cat "$_cf" 2>/dev/null || true
  fi
}

# Detached per-cycle refresher: spawns ONE background pass guarded by flock so
# passes never stack. Poll loop returns immediately; only the child runs curl.
_refresh_exit_ips() {
  _lk="$ST_DIR/exitip.lock"
  (
    flock -n 9 || exit 0
    for _m in $MEMBERS; do
      _n=${_m%%:*}
      _is_healthy "$_n" && _probe_exit_ip "$_n" >/dev/null
    done
  ) 9>"$_lk" &
}

# ── reconcile ────────────────────────────────────────────────────────────────

_is_healthy() { case " $HEALTHY " in *" $1 "*) return 0 ;; esac; return 1; }

# Lowest metric among healthy; ties keep first.
# If FORCE_POOL is set, return it only if healthy (fail-closed: no silent switch).
_best_pool() {
  if [ -n "$FORCE_POOL" ]; then
    _is_healthy "$FORCE_POOL" && echo "$FORCE_POOL"   # pinned: honor only if healthy
    return                                             # else fail-closed (no output)
  fi
  # Sticky failback: when amnezia.globals.failback=sticky, stay on the currently-active
  # pool as long as it is healthy, instead of auto-returning to a recovered higher-priority
  # tunnel. Only kicks in when _PREV_POOL is non-empty (i.e. after the first reconcile).
  _fb=$(uci -q get amnezia.globals.failback 2>/dev/null || echo auto)
  if [ "$_fb" = "sticky" ] && [ -n "$_PREV_POOL" ] && _is_healthy "$_PREV_POOL"; then
    echo "$_PREV_POOL"
    return
  fi
  _b=""; _bm=9999
  for _m in $MEMBERS; do _n=${_m%%:*}; _met=$(echo "$_m" | cut -d: -f2)
    _is_healthy "$_n" || continue
    [ "$_met" -lt "$_bm" ] && { _b=$_n; _bm=$_met; }
  done
  echo "$_b"
}

_sticky_pick() {  # prefer sticky_target if healthy, else best pool
  _is_healthy "$STICKY_TARGET" && { echo "$STICKY_TARGET"; return; }
  _best_pool
}

reconcile() {
  FORCE_POOL=$(uci -q get amnezia.globals.force_pool 2>/dev/null || echo "")
  _pool=$(_best_pool); _stk=$(_sticky_pick)
  _changed=0
  [ "$_pool" != "${_PREV_POOL:-}" ] && _changed=1
  [ "$_stk"  != "${_PREV_STKY:-}" ] && _changed=1

  if [ "$MODE" = balance ] && [ "${NEXTHOP_OK:-0}" = 1 ]; then
    _list=""
    for _m in $MEMBERS; do _n=${_m%%:*}; _w=$(echo "$_m" | cut -d: -f3)
      _is_healthy "$_n" && _list="$_list $_n:$_w"
    done
    if [ -n "$_list" ]; then routing_set_pool_balance "$_list"; else routing_set_pool_default ""; fi
    # Balance-mode flow migration off a departed member is handled by the resilient
    # nexthop group (idle_timer + bucket reassignment in routing_set_pool_balance).
    # Per-member surgical conntrack flushing (by low-byte ctmark) is a documented
    # future enhancement: it requires a classifier that stamps per-member marks,
    # which is not yet implemented.
  else
    # failover mode — OR balance requested on a kernel WITHOUT `ip nexthop`. In the
    # latter case real load-balancing is impossible (resilient nexthop groups are
    # unavailable), so degrade to failover (lowest-metric / make-default-aware) instead
    # of silently pinning the first tunnel by index. Warn once so it isn't a silent
    # surprise (e.g. make-default appearing to have no effect).
    if [ "$MODE" = balance ] && [ "${_BAL_WARNED:-0}" != 1 ]; then
      amz_log "balance mode unavailable: kernel lacks 'ip nexthop' — using failover (lowest-metric)"
      _BAL_WARNED=1
    fi
    routing_set_pool_default "$_pool"
    # Flush conntrack pool-mark entries on every switch (including awg1→awg2
    # hot failover, not just all-down/blackhole).  Masqueraded flows SNAT'd
    # through the old tunnel would otherwise stay pinned to the dead interface.
    [ "$_changed" = 1 ] && \
      conntrack -D -m "$POOL_MARK/$MARK_MASK" >/dev/null 2>&1
  fi
  routing_set_sticky_default "$_stk"
  _PREV_POOL="$_pool"; _PREV_STKY="$_stk"; _PREV_HEALTHY="$HEALTHY"
}

# ── state JSON writer ─────────────────────────────────────────────────────────

write_state() {
  _pool=$1; _stk=$2; _alldown=true; [ -n "$_pool" ] && _alldown=false
  _t=""
  _now=$(date +%s 2>/dev/null || echo 0)
  for _m in $MEMBERS; do _n=${_m%%:*}; _met=$(echo "$_m"|cut -d: -f2); _w=$(echo "$_m"|cut -d: -f3)
    _up=false; _is_healthy "$_n" && _up=true
    _car=false; { [ "$_n" = "$_pool" ] || [ "$_n" = "$_stk" ]; } && _car=true
    _hs=$(awg show "$_n" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
    if [ -n "$_hs" ] && [ "$_hs" -gt 0 ] 2>/dev/null; then
      _hs_age=$(( _now - _hs ))
    else
      _hs_age=-1
    fi
    # Read exit-IP from cache only (probe runs detached; no curl on the poll path).
    _eip=$(cat "$ST_DIR/exitip.${_n}.ip" 2>/dev/null || true)
    _ets=$(cat "$ST_DIR/exitip.${_n}.ts" 2>/dev/null || echo 0)
    if [ -n "$_eip" ] && [ "$_up" = true ]; then
      _eipj="\"$_eip\""
      _eage=$(( _now - _ets ))
    else
      _eipj=null
      _eage=null
    fi
    _t="$_t{\"name\":\"$_n\",\"enabled\":true,\"up\":$_up,\"metric\":$_met,\"weight\":$_w,\"handshake_age\":$_hs_age,\"carrying\":$_car,\"exit_ip\":${_eipj},\"exit_ip_age\":${_eage}},"
  done

  # C1: read routing_mode from UCI so the LuCI select shows live state.
  _rmode=$(uci -q get amnezia.config.routing_mode 2>/dev/null || echo "tunnel-default")
  [ -z "$_rmode" ] && _rmode="tunnel-default"

  # H1: read per-source enabled state so the LuCI checkboxes show live state.
  # Five known source names (order matches the LuCI render list).
  _sources_json=""
  for _sname in itdoginfo_inside itdoginfo_services refilter_domains refilter_ip antifilter; do
    _sen=$(uci -q get "amnezia.${_sname}.enabled" 2>/dev/null || echo "0")
    [ -z "$_sen" ] && _sen="0"
    # Emit JSON boolean.
    if [ "$_sen" = "1" ]; then _sbool=true; else _sbool=false; fi
    _sources_json="${_sources_json}\"${_sname}\":${_sbool},"
  done
  _sources_json="${_sources_json%,}"

  # Emit force_pool: the current pinned tunnel or null.
  _fp=null; [ -n "$FORCE_POOL" ] && _fp="\"$FORCE_POOL\""

  # Emit failback mode so the UI can reflect the current setting.
  _fb_mode=$(uci -q get amnezia.globals.failback 2>/dev/null || echo auto)
  [ -z "$_fb_mode" ] && _fb_mode=auto

  # Write to a temp file on the same filesystem then atomically rename so the
  # LuCI reader never sees a partial/truncated JSON.
  _sf_tmp="${STATE_FILE}.tmp.$$"
  # nexthop_supported: lets the LuCI Mode control flag that balance is unavailable
  # on this kernel (and is silently running as failover) instead of confusing the user.
  _nhs=$([ "${NEXTHOP_OK:-0}" = 1 ] && echo true || echo false)
  printf '{"mode":"%s","routing_mode":"%s","active_pool":%s,"active_sticky":%s,"all_down":%s,"force_pool":%s,"failback":"%s","nexthop_supported":%s,"sources":{%s},"tunnels":[%s]}\n' \
    "$MODE" "$_rmode" \
    "$([ -n "$_pool" ] && echo "\"$_pool\"" || echo null)" \
    "$([ -n "$_stk" ] && echo "\"$_stk\"" || echo null)" \
    "$_alldown" "$_fp" "$_fb_mode" "$_nhs" "$_sources_json" "${_t%,}" > "$_sf_tmp"
  mv "$_sf_tmp" "$STATE_FILE"
}

# ── main loop ────────────────────────────────────────────────────────────────

run_loop() {
  POLL_INTERVAL=${POLL_INTERVAL:-10}
  # Read config from UCI
  MODE=$(uci -q get amnezia.globals.mode 2>/dev/null || echo failover)
  STICKY_TARGET=$(uci -q get amnezia.globals.sticky_target 2>/dev/null || echo "")
  MEMBERS=""
  _i=1
  while [ "$_i" -le "${MAX_TUNNELS:-5}" ]; do
    _tun="awg$_i"
    _en=$(uci -q get "amnezia.${_tun}.enabled" 2>/dev/null || echo 0)
    if [ "$_en" = 1 ]; then
      _met=$(uci -q get "amnezia.${_tun}.metric" 2>/dev/null || echo "$_i")
      _w=$(uci -q get "amnezia.${_tun}.weight" 2>/dev/null || echo 1)
      _track=$(uci -q get "amnezia.${_tun}.track_ip" 2>/dev/null || echo "1.1.1.1")
      MEMBERS="$MEMBERS ${_tun}:${_met}:${_w}"
      # Each awgN gets a dedicated probe table: PROBE_TBL_BASE + (N-1).
      # awg1 -> 110, awg2 -> 111, ..., awg5 -> 114.  Unique tables guarantee
      # that tunnels sharing the same track_ip each get an independent probe route.
      _probe_tbl=$(( PROBE_TBL_BASE + _i - 1 ))
      probe_setup "$_tun" "$_track" "$_probe_tbl"
      # Preserve debounce state across daemon restarts so a tunnel confirmed down
      # does not require a fresh 3-sample reconvergence (~30s) on every ctl mutation.
      # Only seed "up 0" if no prior state file exists (fresh/never-seen slot).
      # Belt-and-suspenders: also clear any stale exit-IP cache for a brand-new
      # slot so a re-added tunnel cannot inherit the previous tenant's exit IP.
      if [ ! -f "$ST_DIR/$_tun" ]; then
        state_reset "$_tun"
        rm -f "$ST_DIR/exitip.${_tun}.ip" "$ST_DIR/exitip.${_tun}.ts"
      fi
    fi
    _i=$((_i+1))
  done
  MEMBERS="${MEMBERS# }"
  HEALTHY=""
  # Resilient nexthop groups (balance mode) require kernel `ip nexthop` support.
  # Probe once at startup; reused by reconcile (degrade decision) + write_state (UI hint).
  NEXTHOP_OK=0; routing_nexthop_supported && NEXTHOP_OK=1
  _PREV_POOL=""; _PREV_STKY=""; _PREV_HEALTHY=""

  # Subscribe to netifd interface events and touch the trigger on each event so the
  # poll loop wakes up early.  The inner loop re-arms the listener if it dies (e.g.
  # ubus restart or netifd reload).  NOTE: the exact ubus object/method name for
  # OpenWrt 24.10 must be confirmed in the Tier-3 hardware spike; "network.interface"
  # is the canonical netifd event bus object.  Periodic polling remains the fallback.
  _trigger="$ST_DIR/immediate"
  # Spawn the listener in a new session via setsid so that it gets its own
  # process group (PGID == PID of the setsid'd subshell).  When the cleanup
  # trap fires, `kill -- "-${_ubus_pid}"` delivers SIGTERM to that entire
  # process group, which includes the child "ubus listen" process even if the
  # subshell exec'd away.  Without setsid, the subshell inherits the daemon's
  # PGID and process-group kill would deliver SIGTERM to the daemon itself.
  setsid sh -c '
    _trig=$1
    while true; do
      ubus listen network.interface 2>/dev/null | while IFS= read -r _e; do
        touch "$_trig"
      done
      sleep 2
    done
  ' -- "$_trigger" &
  _ubus_pid=$!

  # ── cleanup trap ─────────────────────────────────────────────────────────────
  # Must be defined after _ubus_pid is assigned so the variable is in scope.
  # Registered for TERM (procd stop/restart), INT (manual Ctrl-C), and EXIT
  # (any other exit path).  The EXIT trap fires even when TERM/INT are caught,
  # so we guard with a flag to avoid running cleanup twice.
  _cleanup_done=0
  _daemon_cleanup() {
    [ "$_cleanup_done" = 1 ] && return
    _cleanup_done=1
    # Kill the listener subshell and its child "ubus listen".  Try process-group
    # kill first (works when the subshell did not exec away); fall back to direct
    # PID kill.  Silence errors in case the process already exited.
    kill -- "-${_ubus_pid}" 2>/dev/null || kill -- "$_ubus_pid" 2>/dev/null
    # Free the per-member probe route + ip rule that probe_setup installed.
    # Recompute each tunnel's probe table id (PROBE_TBL_BASE + awgN index - 1)
    # to match what probe_setup used at startup.
    for _m in $MEMBERS; do _n=${_m%%:*}
      _track=$(uci -q get "amnezia.${_n}.track_ip" 2>/dev/null || echo "1.1.1.1")
      _ni=${_n#awg}
      _probe_tbl=$(( PROBE_TBL_BASE + _ni - 1 ))
      probe_cleanup "$_n" "$_track" "$_probe_tbl"
    done
    amz_log "failover daemon stopped"
    exit 0
  }
  trap '_daemon_cleanup' TERM INT EXIT

  amz_log "failover loop started: members=$MEMBERS mode=$MODE"
  while true; do
    HEALTHY=""
    for _m in $MEMBERS; do _n=${_m%%:*}
      _track=$(uci -q get "amnezia.${_n}.track_ip" 2>/dev/null || echo "1.1.1.1")
      if tunnel_healthy "$_n" "$_track"; then
        if debounce "$_n" 1; then
          _on_tunnel_up "$_n"
        fi
        HEALTHY="$HEALTHY $_n"
      else
        if debounce "$_n" 0; then amz_log "tunnel $_n went down"; fi
      fi
    done
    HEALTHY="${HEALTHY# }"
    _pool=$(_best_pool); _stk=$(_sticky_pick)
    reconcile
    _refresh_exit_ips
    write_state "$_pool" "$_stk"
    rm -f "$_trigger"
    _slept=0
    while [ "$_slept" -lt "$POLL_INTERVAL" ]; do
      sleep 1; _slept=$((_slept+1))
      [ -f "$_trigger" ] && break
    done
  done
}

[ "$1" = "--source-only" ] && return 0 2>/dev/null
run_loop
