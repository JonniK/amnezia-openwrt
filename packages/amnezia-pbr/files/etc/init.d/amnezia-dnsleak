#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # USE_PROCD/START/STOP are consumed by /etc/rc.common framework
USE_PROCD=1
START=98
STOP=10

start_service() {
  [ "$(uci -q get amnezia.config.dnsleak_enabled)" = 1 ] || return 0
  procd_open_instance
  procd_set_param command /usr/bin/amnezia-dnsleak-ctl watchdog
  procd_set_param respawn
  procd_close_instance
}

stop_service() {
  # procd terminates the respawned watchdog instance automatically.
  # Do NOT call `disable` here — stopping the monitor must not tear down
  # the persistent firewall block. Feature teardown is the explicit
  # `amnezia-dnsleak-ctl disable` verb's job only.
  return 0
}
