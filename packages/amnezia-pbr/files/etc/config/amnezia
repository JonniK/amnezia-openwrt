# /etc/config/amnezia
# UCI config for amnezia-pbr-openwrt. Edit via:
#   uci set amnezia.config.<key>=<value> && uci commit amnezia
# or via LuCI: Network -> Amnezia.
#
# This file is the canonical home for package-level toggles. State stamps
# (blockcheck.json, ru-update.json, etc.) live as files under /etc/amnezia/
# because UCI is awkward for nested JSON.

config amnezia 'config'
	# routing_mode controls whether AmneziaWG is the default route or
	# only used for an explicit must-tunnel allow-list. Both modes are
	# fully implemented and switchable at runtime.
	#   tunnel-default  (default) LAN -> tunnel by default; .ru TLDs and
	#                   RU CIDRs route direct via WAN. Force-tunnel list
	#                   is dormant in this mode.
	#   direct-default  LAN -> WAN direct by default; only addresses in
	#                   amnezia_force4 (allowlist) and sticky addresses go
	#                   through the tunnel. Useful when most traffic works
	#                   fine on direct + zapret.
	# Switch via: amnezia-failover-ctl set-routing-mode tunnel-default|direct-default
	# or via the Routing Mode selector in LuCI -> Network -> Amnezia.
	option routing_mode 'tunnel-default'

	# Stamp the install so `uci show amnezia` doubles as a quick "what's
	# running" report. install-amnezia-pbr.sh updates these on every run;
	# preserved across re-runs only if user has not overridden routing_mode.
	option installed_version 'main'
	option installed_ts ''
	# option master_enabled '1'    # Master kill-switch: 0 = fail-open (all VPN + DoT off, LAN -> WAN direct). Default 1.
	option dot_enabled '0'
	option dns_provider 'quad9'
	option dot_resolver ''
	option doh_resolver ''
	option doh_bootstrap ''
	option dns_active_tier 'off'

config globals 'globals'
	option mode 'failover'
	option sticky_target 'awg1'

config tunnel 'awg1'
	option enabled '1'
	option label 'Primary'
	option metric '1'
	option weight '1'

# Force-list sources for amnezia-force-update.
# itdoginfo: two complementary lists — RKN-blocked (inside) and geoblock-RU services.
config force_source 'itdoginfo_inside'
	option enabled '1'
	option kind 'domains'
	# F1-verified 2026-06-17: HTTP 200, RKN-blocked domains (intent a).
	# Repo: itdoginfo/allow-domains — Russia/inside-raw.lst
	option url 'https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Russia/inside-raw.lst'

config force_source 'itdoginfo_services'
	option enabled '1'
	option kind 'domains'
	# F1-verified 2026-06-17: HTTP 200, geoblock-RU services (intent b) —
	# OpenAI/ChatGPT/Claude/Anthropic, Spotify-equiv, etc.
	# Repo: itdoginfo/allow-domains — Categories/geoblock.lst
	option url 'https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Categories/geoblock.lst'

config force_source 'refilter_domains'
	option enabled '0'
	option kind 'domains'
	# F1-verified 2026-06-17: HTTP 200.
	# Repo: 1andrevich/Re-filter-lists — domains_all.lst
	option url 'https://raw.githubusercontent.com/1andrevich/Re-filter-lists/main/domains_all.lst'

config force_source 'refilter_ip'
	option enabled '0'
	option kind 'cidr'
	# F1-verified 2026-06-17: HTTP 200.
	# Repo: 1andrevich/Re-filter-lists — ipsum.lst (IP/CIDR)
	option url 'https://raw.githubusercontent.com/1andrevich/Re-filter-lists/main/ipsum.lst'

config force_source 'antifilter'
	option enabled '0'
	option kind 'domains'
	# F1-verified 2026-06-17: HTTP 200.
	# Source: antifilter.download/list/domains.lst
	option url 'https://antifilter.download/list/domains.lst'
