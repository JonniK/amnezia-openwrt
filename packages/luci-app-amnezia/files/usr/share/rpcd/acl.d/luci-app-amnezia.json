{
	"luci-app-amnezia": {
		"description": "AmneziaWG multi-tunnel failover controls, RU IP list refresh, zapret DPI bypass, and tunnel/allowlist management",
		"read": {
			"uci": [ "amnezia" ],
			"file": {
				"/etc/amnezia/ru-update.json":          [ "read" ],
				"/etc/amnezia/blockcheck.json":         [ "read" ],
				"/etc/amnezia/seed-must-tunnel.list":   [ "read" ],
				"/var/run/amnezia-failover.json":        [ "read" ],
				"/etc/amnezia/force-tunnel.list":       [ "read" ],
				"/etc/amnezia/force-update.json":       [ "read" ],
				"/tmp/amnezia-fo/probe-page.json":      [ "read" ],
				"/tmp/amnezia-fo/watch.json":           [ "read" ]
			}
		},
		"write": {
			"file": {
				"/usr/bin/amnezia-ru-cidr":         [ "exec" ],
				"/usr/bin/zapret-toggle":           [ "exec" ],
				"/usr/bin/zapret-status":           [ "exec" ],
				"/usr/bin/zapret-blockcheck":       [ "exec" ],
				"/usr/bin/zapret-apply":            [ "exec" ],
				"/usr/bin/zapret-probe":            [ "exec" ],
				"/usr/bin/zapret-verify":           [ "exec" ],
				"/usr/bin/amnezia-failover-ctl":    [ "exec" ],
				"/usr/bin/amnezia-status":          [ "exec" ],
				"/usr/bin/amnezia-tunnel-ctl":      [ "exec" ],
				"/usr/bin/amnezia-force-load":      [ "exec" ],
				"/usr/bin/amnezia-force-update":    [ "exec" ],
				"/usr/bin/amnezia-dns-ctl":         [ "exec" ],
				"/usr/bin/amnezia-app-ctl":         [ "exec" ],
				"/usr/bin/amnezia-autotunnel":      [ "exec" ],
				"/usr/bin/amnezia-covert-ctl":      [ "exec" ],
				"/etc/amnezia/covert/vk-cookies.json": [ "write" ]
			}
		}
	}
}
