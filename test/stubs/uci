#!/bin/sh
echo "uci $*" >> "${STUB_LOG:-/dev/null}"
# Normalize: strip leading -q flag so verb is always $1 after normalization.
_verb="$1"
if [ "$_verb" = "-q" ]; then shift; _verb="$1"; fi
# delete always returns 1: real UCI returns 1 when the section/option does not
# exist (the while-loop teardown idiom relies on this to terminate).
case "$_verb" in
  add) echo "amzsec"; exit 0 ;;
  delete) exit 1 ;;
  del_list) exit 0 ;;
  add_list) exit 0 ;;
esac

# UCI_DNSMASQ_<opt> override: handles dhcp.@dnsmasq[0].<opt> keys via the
# autolearn-test convention (export UCI_DNSMASQ_<opt>='value'). When the override
# is unset, FALL THROUGH to the generic UCI_GET_* block below so the DoT-test
# convention (UCI_GET_dhcp__dnsmasq_0__<opt>) can resolve the same key.
if [ "$1" = get ]; then
  case "$2" in
    dhcp.@dnsmasq"["0"]".*)
      _opt="${2##*.}"
      _envk="UCI_DNSMASQ_$(printf '%s' "$_opt" | tr '-' '_')"
      eval _envv="\${$_envk+set}"
      if [ "${_envv:-}" = set ]; then eval printf '%s\\n' "\"\$$_envk\""; exit 0; fi
      ;;
  esac
fi

# UCI_GET_* dynamic resolution: maps "uci -q get a.b.c" -> env var UCI_GET_a_b_c.
# Normalized via tr -c '[:alnum:]' '_' so @[]-bracket keys yield valid var names
# (e.g. dhcp.@dnsmasq[0].server -> UCI_GET_dhcp__dnsmasq_0__server). Checked BEFORE
# the hardcoded arms so tests can override any key.
if [ "$1" = get ]; then
  _envk="UCI_GET_$(printf '%s' "$2" | tr -c '[:alnum:]' '_')"
  eval _envv="\${$_envk+set}"
  if [ "${_envv:-}" = set ]; then eval printf '%s\\n' "\"\$$_envk\""; exit 0; fi
fi

# UCI_SHOW_network dynamic resolution: emits the env var content when set.
# Checked BEFORE the hardcoded "show network" arm.
if [ "$1" = show ] && [ "$2" = network ] && [ -n "${UCI_SHOW_network:-}" ]; then
  printf '%s\n' "$UCI_SHOW_network"; exit 0
fi

# UCI_SHOW_<arg> generic dynamic resolution (DoT): emits env var content for any show key.
if [ "$1" = show ] && [ -n "$2" ]; then
  _showk="UCI_SHOW_$(printf '%s' "$2" | tr -c '[:alnum:]' '_')"
  eval _showv="\${$_showk+set}"
  if [ "${_showv:-}" = set ]; then eval printf '%s\\n' "\"\$$_showk\""; exit 0; fi
fi

case "$1 $2" in
  "show network") echo "network.@interface[0]=interface" ;;
  "get amnezia") exit 0 ;;
  "get amnezia.globals.sticky_target") echo "awg1" ;;
  "get amnezia.config.routing_mode") echo "tunnel-default" ;;
  "get amnezia.itdoginfo_inside.enabled") echo "1" ;;
  "get amnezia.itdoginfo_services.enabled") echo "1" ;;
  "get amnezia.refilter_domains.enabled") echo "0" ;;
  "get amnezia.refilter_ip.enabled") echo "0" ;;
  "get amnezia.antifilter.enabled") echo "0" ;;
  "show amnezia")
    # UCI_FAKE_TUNNELS: space-separated list of tunnel names to report as enabled.
    # TYPE lines are unquoted (amnezia.<name>=tunnel); option values are single-quoted
    # to match real OpenWrt uci show output (amnezia.<name>.enabled='1').
    if [ -n "$UCI_FAKE_TUNNELS" ]; then
      for _t in $UCI_FAKE_TUNNELS; do
        echo "amnezia.${_t}=tunnel"
        echo "amnezia.${_t}.enabled='1'"
      done
    fi
    # UCI_FAKE_SOURCES: space-separated list of "name:enabled" pairs, e.g. "itdoginfo_inside:1 antifilter:0".
    # TYPE lines are unquoted; option values are single-quoted to match real OpenWrt uci show.
    if [ -n "$UCI_FAKE_SOURCES" ]; then
      for _s in $UCI_FAKE_SOURCES; do
        _sname="${_s%%:*}"; _senabled="${_s##*:}"
        echo "amnezia.${_sname}=force_source"
        echo "amnezia.${_sname}.enabled='${_senabled}'"
        echo "amnezia.${_sname}.url='https://example.com/${_sname}.txt'"
        echo "amnezia.${_sname}.kind='domains'"
      done
    fi
    # UCI_FAKE_APPS: space-separated list of "name:enabled:kind" triples for tunnel-app sources.
    # Supports kind=static (no url), kind=as (no url, has asn), kind=cidr (has url).
    if [ -n "$UCI_FAKE_APPS" ]; then
      for _a in $UCI_FAKE_APPS; do
        _aname=$(printf '%s' "$_a" | cut -d: -f1)
        _aenabled=$(printf '%s' "$_a" | cut -d: -f2)
        _akind=$(printf '%s' "$_a" | cut -d: -f3)
        _akind="${_akind:-cidr}"
        echo "amnezia.${_aname}=force_source"
        echo "amnezia.${_aname}.enabled='${_aenabled}'"
        echo "amnezia.${_aname}.kind='${_akind}'"
        case "$_akind" in
          cidr)
            _aurl_envk="UCI_GET_amnezia_${_aname}_url"
            eval _aurl="\${${_aurl_envk}:-https://example.com/${_aname}.txt}"
            echo "amnezia.${_aname}.url='${_aurl}'"
            ;;
          as)
            _aasn_envk="UCI_GET_amnezia_${_aname}_asn"
            eval _aasn="\${${_aasn_envk}:-0}"
            echo "amnezia.${_aname}.asn='${_aasn}'"
            ;;
        esac
      done
    fi ;;
  "get firewall.vpn.network")
    # Return space-separated members on one line (how real uci get behaves for lists).
    if [ -n "$UCI_FAKE_FWNET" ]; then
      echo "$UCI_FAKE_FWNET"
    else
      exit 1
    fi ;;
  "show firewall")
    # UCI_FAKE_FWNET: space-separated list of firewall.vpn.network members.
    # Real OpenWrt 24.10 renders the list on ONE line with quoted space-separated values:
    #   firewall.vpn.network='awg1' 'awg2'
    if [ -n "$UCI_FAKE_FWNET" ]; then
      _line=""
      for _n in $UCI_FAKE_FWNET; do
        if [ -z "$_line" ]; then
          _line="'${_n}'"
        else
          _line="${_line} '${_n}'"
        fi
      done
      echo "firewall.vpn.network=${_line}"
    fi ;;
  get*)
    # Generic UCI_GET_<normalized_key> env lookup (normalized via tr -c '[:alnum:]' '_').
    # Allows tests to export UCI_GET_amnezia_config_foo='bar' and have
    # `uci -q get amnezia.config.foo` return 'bar'. Handles @[]-brackets too.
    _envk="UCI_GET_$(printf '%s' "$2" | tr -c '[:alnum:]' '_')"
    eval _envv="\${$_envk+set}"
    if [ "${_envv:-}" = set ]; then eval printf '%s\\n' "\"\$$_envk\""; exit 0; fi
    # Dynamic uci -q get for force_source attributes: serve from UCI_FAKE_SOURCES.
    # Pattern: "get amnezia.<name>.<opt>" where <name> appears in UCI_FAKE_SOURCES.
    _key="$2"
    case "$_key" in
      amnezia.*.*)
        _pkg="${_key%%.*}"; _rest="${_key#*.}"
        _sec="${_rest%%.*}"; _opt="${_rest#*.}"
        if [ "$_pkg" = "amnezia" ] && [ -n "$UCI_FAKE_SOURCES" ]; then
          for _s in $UCI_FAKE_SOURCES; do
            _sname="${_s%%:*}"; _senabled="${_s##*:}"
            if [ "$_sname" = "$_sec" ]; then
              case "$_opt" in
                enabled) echo "$_senabled"; exit 0 ;;
                url)     echo "https://example.com/${_sname}.txt"; exit 0 ;;
                kind)    echo "domains"; exit 0 ;;
              esac
            fi
          done
        fi
        # UCI_FAKE_APPS: serve attributes for tunnel-app force_source sections.
        if [ "$_pkg" = "amnezia" ] && [ -n "$UCI_FAKE_APPS" ]; then
          for _a in $UCI_FAKE_APPS; do
            _aname=$(printf '%s' "$_a" | cut -d: -f1)
            _aenabled=$(printf '%s' "$_a" | cut -d: -f2)
            _akind=$(printf '%s' "$_a" | cut -d: -f3)
            _akind="${_akind:-cidr}"
            if [ "$_aname" = "$_sec" ]; then
              case "$_opt" in
                enabled) echo "$_aenabled"; exit 0 ;;
                kind)    echo "$_akind"; exit 0 ;;
                url)
                  # Return UCI_GET_amnezia_<name>_url if set, else default.
                  _urlenv="UCI_GET_amnezia_${_aname}_url"
                  eval _urlval="\${${_urlenv}:-https://example.com/${_aname}.txt}"
                  echo "$_urlval"; exit 0 ;;
                asn)
                  # Return UCI_GET_amnezia_<name>_asn if set.
                  _asnenv="UCI_GET_amnezia_${_aname}_asn"
                  eval _asnval="\${${_asnenv}:-0}"
                  echo "$_asnval"; exit 0 ;;
                cidr)
                  # Return UCI_GET_amnezia_<name>_cidr (space-separated list on one line).
                  _cidrenv="UCI_GET_amnezia_${_aname}_cidr"
                  eval _cidrval="\${${_cidrenv}:-}"
                  if [ -n "$_cidrval" ]; then echo "$_cidrval"; exit 0; fi
                  exit 1 ;;
              esac
            fi
          done
        fi
        ;;
    esac
    exit 1
    ;;
esac
exit 0
