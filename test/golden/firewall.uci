set firewall.vpn=zone
set firewall.vpn.name=vpn
set firewall.vpn.network=awg1 awg2
set firewall.vpn.input=REJECT
set firewall.vpn.output=ACCEPT
set firewall.vpn.forward=REJECT
set firewall.vpn.masq=1
set firewall.vpn.mtu_fix=1
set firewall.vpn_fwd=forwarding
set firewall.vpn_fwd.src=lan
set firewall.vpn_fwd.dest=vpn
set firewall.amnezia_v6_drop=rule
set firewall.amnezia_v6_drop.name=amnezia-drop-v6-forward
set firewall.amnezia_v6_drop.src=lan
set firewall.amnezia_v6_drop.dest=wan
set firewall.amnezia_v6_drop.family=ipv6
set firewall.amnezia_v6_drop.proto=all
set firewall.amnezia_v6_drop.target=DROP
